rules_version = '2';

// =====================================================================
// Tubiscope — Règles de sécurité Firestore (v3, ajout Tubiscope Culture)
// =====================================================================
// Modèle de sécurité
//
// 1. users/{uid}                                     : données privées du user
//    - isPremium       : réservé Cloud Function Stripe
//    - themeCount      : nombre de thèmes personnels (Studio/Gratuit)
//    - watchLater      : array de youtubeIds (10 max)
//    - culturePrefs    : { themes: [...], setAt, updatedAt } pour Tubiscope Culture
// 2. users/{uid}/themes/{themeId}                    : thèmes custom du user
// 3. users/{uid}/themes/{themeId}/programs/{progId}  : vidéos d'un thème custom du user
// 4. scopes/{scopeId}/programs/{progId}              : vidéos des scopes éditeur (admin)
//    + scopes/cult_xxx/programs/{progId}             : vidéos Tubiscope Culture (sync serveur)
// 5. artifacts/{appId}/public/data/programs/{progId} : ANCIENNE collection, read-only
//
// Identification admin : custom claim `admin = true`
// Le sync Culture tourne avec firebase-admin (service account), il bypass
// les rules. Les rules autorisent donc la lecture publique sur les scopes
// Culture, mais pas l'écriture côté client.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Helpers -----
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Champs autorisés à la création d'un programme
    function isValidProgramCreate(data) {
      return data.keys().hasAll(['youtubeId', 'channelId', 'categoryId', 'addedBy', 'createdAt'])
          && data.youtubeId is string && data.youtubeId.size() > 0 && data.youtubeId.size() < 20
          && data.channelId is string && data.channelId.size() > 0 && data.channelId.size() < 50
          && data.categoryId is string && data.categoryId.size() > 0
          && data.addedBy is string
          && data.createdAt is number
          && data.addedBy == request.auth.uid;
    }

    // Champs immutables d'un programme (identité du doc)
    function isValidProgramUpdate(before, after) {
      return after.youtubeId == before.youtubeId
          && after.channelId == before.channelId
          && after.addedBy == before.addedBy
          && after.createdAt == before.createdAt;
    }

    // =========================================================
    // 1. Données utilisateur
    // =========================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Création du doc user à la première connexion. isPremium doit valoir false.
      allow create: if isOwner(userId)
                    && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false);

      // Update : owner peut tout sauf isPremium (réservé Cloud Function Stripe). Admin peut tout.
      allow update: if (
                      isOwner(userId)
                      && (
                        !('isPremium' in request.resource.data)
                        || request.resource.data.isPremium == resource.data.isPremium
                      )
                    )
                    || isAdmin();

      allow delete: if isOwner(userId) || isAdmin();

      // -----------------------------------------------------
      // 2. Thèmes custom du user
      // -----------------------------------------------------
      match /themes/{themeId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) || isAdmin();

        // -----------------------------------------------------
        // 3. Programmes d'un thème custom du user
        // -----------------------------------------------------
        match /programs/{progId} {
          // Lecture : le user concerné et l'admin
          allow read: if isOwner(userId) || isAdmin();

          // Création : owner du thème, validation des champs, addedBy = uid
          allow create: if isOwner(userId)
                        && isValidProgramCreate(request.resource.data);

          // Update : owner ou admin, champs identitaires immuables
          allow update: if (isOwner(userId) || isAdmin())
                        && isValidProgramUpdate(resource.data, request.resource.data);

          // Suppression : owner ou admin
          allow delete: if isOwner(userId) || isAdmin();
        }
      }
    }

    // =========================================================
    // 4. Scopes éditeur (5 thématiques fixes définies dans App.jsx)
    // =========================================================
    // Le document scopes/{scopeId} n'existe pas forcément (sous-collection orpheline).
    // On gère uniquement les programmes dedans.
    match /scopes/{scopeId}/programs/{progId} {
      // Lecture : tout user authentifié (gratuits et Studio)
      allow read: if isSignedIn();

      // Création : admin uniquement
      allow create: if isAdmin()
                    && isValidProgramCreate(request.resource.data);

      // Update : admin uniquement, champs identitaires immuables
      allow update: if isAdmin()
                    && isValidProgramUpdate(resource.data, request.resource.data);

      // Suppression : admin uniquement
      allow delete: if isAdmin();
    }

    // =========================================================
    // 5. Ancienne collection programs (read-only le temps de la migration)
    // =========================================================
    // À supprimer une fois la migration validée et l'app stabilisée sur la v2.
    match /artifacts/{appId}/public/data/programs/{progId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // =========================================================
    // 6. Collection /channels (gestion centralisée des chaînes YouTube)
    // =========================================================
    // Source de vérité unifiée Tubiscope + Culture. Lecture authentifiée
    // (le hook useCultureChannels alimente la liste des chaînes affichée
    // dans la page publique CultureApp, sinon l'UI retombe sur le fallback
    // statique src/data/cultureChannels.js). Écriture admin only.
    match /channels/{channelId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================================================
    // 7. Collection /categories (catégories éditables des deux apps)
    // =========================================================
    // Lecture authentifiée (les apps en ont besoin pour afficher les labels),
    // écriture admin only.
    match /categories/{categoryId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================================================
    // 8. Collection /channelProposals (Studio propose, rédaction tranche)
    // =========================================================
    // - create : tout user authentifié, en se déclarant lui-même comme
    //            auteur. status forcé à 'pending'. Le serveur ne fait pas
    //            confiance à isPremium côté client : on accepte tous les
    //            users signed-in, la modération suit côté admin.
    // - read   : auteur (peut suivre l'état de sa proposition) ou admin.
    // - update / delete : admin only (changement de status, archivage).
    function isValidProposalCreate(data) {
      return data.keys().hasAll(['handle', 'suggestedCategoryId', 'status', 'proposedBy', 'createdAt'])
          && data.handle is string && data.handle.size() > 0 && data.handle.size() < 200
          && data.suggestedCategoryId is string
          && data.status == 'pending'
          && data.proposedBy == request.auth.uid
          && data.createdAt is number;
    }

    match /channelProposals/{proposalId} {
      allow create: if isSignedIn() && isValidProposalCreate(request.resource.data);
      allow read:   if isAdmin()
                    || (isSignedIn() && resource.data.proposedBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // 8. Fallback : tout le reste est interdit par défaut
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
